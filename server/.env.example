# Environment for running the API outside Docker (npm run dev). Copy to server/.env.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://quiz:quiz@localhost:5433/quizlive
# DATABASE_SSL=true            # for cloud databases (Neon, Supabase)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_EMAIL=admin@quizlive.local
ADMIN_PASSWORD=Admin#12345
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
