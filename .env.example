# Copy to .env and adjust. Never commit the real .env file.
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz
POSTGRES_DB=quizlive

# Secrets (generate long random values for production!)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# First administrator, created on startup if it does not exist
ADMIN_EMAIL=admin@quizlive.local
ADMIN_PASSWORD=Admin#12345

# Comma-separated list of allowed browser origins (CORS white list)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Rate limiting (requests per window per IP)
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30
