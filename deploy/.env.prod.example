# Production environment for docker-compose.prod.yml. Copy to ../.env on the VPS (chmod 600).
# Generate secrets with: openssl rand -hex 32
APP_DOMAIN=quizlive.cloudyyy.tech

POSTGRES_USER=quiz
POSTGRES_PASSWORD=
POSTGRES_DB=quizlive

JWT_SECRET=
JWT_REFRESH_SECRET=

ADMIN_EMAIL=admin@quizlive.cloudyyy.tech
ADMIN_PASSWORD=

RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30

# GlitchTip (self-hosted, Sentry-compatible)
GLITCHTIP_SECRET_KEY=
# DSNs of the GlitchTip projects (backend / frontend); empty = error tracking off
SENTRY_DSN=
VITE_SENTRY_DSN=

# Grafana (logs UI) admin password
GRAFANA_ADMIN_PASSWORD=
